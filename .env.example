# Required for the "Photo" tab (AI food/exercise photo scanning).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for Apple Watch/Health sync. Set this to a random string, and
# use the same value in your iOS Shortcut's request header.
HEALTH_WEBHOOK_SECRET=

# Auto-injected by Vercel's Upstash Redis integration (Storage tab) --
# you don't need to set these by hand, just connect the integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# See HEALTH_SETUP.md for full step-by-step setup instructions.
